import "XamlTitleBar.idl";

namespace XamlHostingKit
{
    runtimeclass WindowCreationOptions
    {
        WindowCreationOptions();

        [interface_name("IWindowCreationOptions", 4D4A4925-D702-C0DE-9689-16CA3D201BA1)]
        {
            String Title                        { get; set; };
            Int32  Left                         { get; set; };
            Int32  Top                          { get; set; };
            Int32  Width                        { get; set; };
            Int32  Height                       { get; set; };
            WindowStyles Styles                 { get; set; };
            WindowExtendedStyles ExtendedStyles { get; set; };
        }
    };

    runtimeclass XamlWindow
    {
        [interface_name("IXamlWindow", 55B829F3-C545-CAFE-B440-410527C2C569)]
        {
            String                  Title          { get; set; };
            WindowStyles            Styles         { get; set; };
            WindowExtendedStyles    ExtendedStyles { get; set; };

            Boolean                                           IsVisible           { get; };
            Windows.UI.WindowId                               WindowHandle        { get; };
            Windows.Foundation.Rect                           Bounds              { get; };
            Windows.UI.Xaml.Window                            SystemWindow        { get; };
            Windows.ApplicationModel.Core.CoreApplicationView CoreApplicationView { get; };

            XamlHostingKit.XamlTitleBar       TitleBar        { get; };
            Windows.UI.Core.CoreDispatcher    Dispatcher      { get; };
            Windows.System.DispatcherQueue    DispatcherQueue { get; };
            Windows.UI.Core.CoreWindow        CoreWindow      { get; };
            Windows.UI.Composition.Compositor Compositor      { get; };
            Windows.UI.UIContext              UIContext       { get; };
            Windows.UI.Xaml.UIElement         Content         { get; set; };

            void Show();
            void Hide();
            void Close();

            [default_overload]
            void Move(Windows.Foundation.Point position);
            void Move(Single x, Single y);

            [default_overload]
            void Resize(Windows.Foundation.Size size);
            void Resize(Single width, Single height);

            event Windows.Foundation.TypedEventHandler<XamlWindow, Boolean> VisibilityChanged;
        }

        [static_name("IXamlWindowStatics", EA4FDB40-8A4F-BABE-8BFD-61BD568785B0)]
        {
            static XamlWindow Current { get; };
        }
    };

    [flags]
    enum WindowStyles
    {
        Overlapped = 0x00000000,
        Popup = 0x80000000,
        Child = 0x40000000,
        Minimize = 0x20000000,
        Maximize = 0x01000000,
        Visible = 0x10000000,
        Disabled = 0x08000000,
        ClipSiblings = 0x04000000,
        ClipChildren = 0x02000000,
        Border = 0x00800000,
        DialogFrame = 0x00400000,
        VerticalScroll = 0x00200000,
        HorizontalScroll = 0x00100000,
        SystemMenu = 0x00080000,
        ThickFrame = 0x00040000,
        Group = 0x00020000,
        TabStop = 0x00010000,
        MinimizeBox = Group,
        MaximizeBox = TabStop,
        Tiled = Overlapped,
        Iconic = Minimize,
        SizeBox = ThickFrame,
        ChildWindow = Child,
        Caption = Border | DialogFrame,
        PopupWindow = Popup | Border | SystemMenu,
        OverlappedWindow = Overlapped | Caption | SystemMenu | ThickFrame | MinimizeBox | MaximizeBox,
        TiledWindow = OverlappedWindow,
        None = Overlapped
    };

    [flags]
    enum WindowExtendedStyles
    {
        None = 0x00000000,
        DialogModalFrame = 0x00000001,
        NoParentNotify = 0x00000004,
        Topmost = 0x00000008,
        AcceptFiles = 0x00000010,
        TransparentToInput = 0x00000020,
        MdiChild = 0x00000040,
        ToolWindow = 0x00000080,
        WindowEdge = 0x00000100,
        ClientEdge = 0x00000200,
        ContextHelp = 0x00000400,
        Right = 0x00001000,
        Left = None,
        RtlReading = 0x00002000,
        LtrReading = None,
        LeftScrollBar = 0x00004000,
        RightScrollBar = None,
        ControlParent = 0x00010000,
        StaticEdge = 0x00020000,
        AppWindow = 0x00040000,
        Layered = 0x00080000,
        NoInheritLayout = 0x00100000,
        NoRedirectionBitmap = 0x00200000,
        LayoutRTL = 0x00400000,
        Composited = 0x02000000,
        NoActivate = 0x08000000,
        OverlappedWindow = WindowEdge | ClientEdge,
        PaletteWindow = WindowEdge | ToolWindow | Topmost
    };
}