namespace XamlHostingKit
{
    runtimeclass XamlTitleBar
    {
        [interface_name("IXamlTitleBar", CE11E370-A818-4DCB-B6E0-EF79C26700A1)]
        {
            Boolean ExtendViewIntoTitleBar { get; set; };

            Single Height { get; };
            Boolean IsVisible { get; };
            Single SystemOverlayLeftInset { get; };
            Single SystemOverlayRightInset { get; };

            void SetTitleBar(Windows.UI.Xaml.UIElement element);

            event Windows.Foundation.TypedEventHandler<XamlTitleBar, Object> IsVisibleChanged;
            event Windows.Foundation.TypedEventHandler<XamlTitleBar, Object> LayoutMetricsChanged;
        }
    };
}