<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <XHKPlatform Condition="'$(Platform)' == 'Win32' and '$(XHKPlatform)' == ''">x86</XHKPlatform>
    <XHKPlatform Condition="'$(Platform)' != 'Win32' and '$(XHKPlatform)' == ''">$(Platform)</XHKPlatform>
    <XHKRidPlatform Condition="('$(Platform)' == 'ARM' or '$(Platform)' == 'ARM32') and '$(XHKRidPlatform)' == ''">win10</XHKRidPlatform>
    <XHKRidPlatform Condition="'$(XHKRidPlatform)' == ''">win</XHKRidPlatform>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)..\..\lib\uap10.0\XamlHostingKit.winmd">
      <Implementation>XamlHostingKit.dll</Implementation>
    </Reference>
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$(XHKRidPlatform)-$(XHKPlatform)\native\XamlHostingKit.dll" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)..\..\include</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>