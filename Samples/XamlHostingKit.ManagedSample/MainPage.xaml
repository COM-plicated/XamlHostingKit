<Page
    x:Class="XamlHostingKit.ManagedSample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XamlHostingKit.ManagedSample"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded">

    <StackPanel x:Name="panel" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Hello from XamlHostingKit!" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Button Content="Create secondary view" HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="Button_Click" />
        <!--Image Source="ms-appx://Microsoft.UI.Xaml.2.8/Microsoft.UI.Xaml/Assets/NoiseAsset_256x256_PNG.png" Stretch="Uniform" Width="50" Height="50" Margin="0,20,0,0" /-->
    </StackPanel>
</Page>
